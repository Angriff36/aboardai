{
  "name": "@aboardai/server",
  "version": "1.0.0",
  "description": "Backend server for AboardAI - provides API for both web and Electron modes",
  "author": "AboardAI Team",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "tsx src/index.ts",
    "build": "tsc && node -e \"const{cpSync}=require('fs');const{join}=require('path');const src=join('src','groups','taskgroup.manifest');const dst=join('dist','groups','taskgroup.manifest');try{cpSync(src,dst);console.log('[build] copied taskgroup.manifest')}catch(e){console.warn('[build] manifest copy:',e.message)}\"",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@angriff36/manifest": "2.22.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.173",
    "@aboardai/dependency-resolver": "1.0.0",
    "@aboardai/git-utils": "1.0.0",
    "@aboardai/model-resolver": "1.0.0",
    "@aboardai/platform": "1.0.0",
    "@aboardai/prompts": "1.0.0",
    "@aboardai/types": "1.0.0",
    "@aboardai/utils": "1.0.0",
    "@github/copilot-sdk": "0.1.16",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex-sdk": "^0.139.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "morgan": "1.10.1",
    "node-pty": "1.1.0-beta41",
    "ws": "8.18.3",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/cookie": "0.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "22.19.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "4.0.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
